DATABASE_URL=""
HTTP_PORT=0
LOG_LEVEL=debug
# Auth
SESSION_TTL=720h
# false only for plain-http local development
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com
# comma-separated frontend origins allowed to call the API with cookies
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# OAuth client ID from Google Cloud Console; leave empty to disable Google sign-in
GOOGLE_CLIENT_ID=
